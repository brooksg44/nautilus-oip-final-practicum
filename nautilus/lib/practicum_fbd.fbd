  // Manual-PushPullls and Manual-Counters: edge toggles with CW/CCW
  // exclusion, five second local Reset hold clears all three totals.
  Branch046 := SEL(NOT(ResetState), Branch046, EQ(Mode, 4))
  Branch047 := SEL(NOT(ResetState), Branch047, NOT(Branch046))
  Branch048 := SEL(NOT(ResetState), Branch048, AND(Branch046, AND(BeltConveyor4mManPB, NOT(PrevBelt))))
  ManBelt := SEL(AND(NOT(ResetState), Branch048), ManBelt, NOT(ManBelt))
  Branch049 := SEL(NOT(ResetState), Branch049, AND(Branch048, ManBelt))
  Branch050 := SEL(NOT(ResetState), Branch050, AND(Branch048, NOT(Branch049)))
  BeltSpeedRef := SEL(AND(NOT(ResetState), Branch049), BeltSpeedRef, 60)
  BeltSpeedRef := SEL(AND(NOT(ResetState), Branch050), BeltSpeedRef, 0)
  Branch051 := SEL(NOT(ResetState), Branch051, AND(Branch046, AND(RejectPusherManPB, NOT(PrevReject))))
  ManReject := SEL(AND(NOT(ResetState), Branch051), ManReject, NOT(ManReject))
  Branch052 := SEL(NOT(ResetState), Branch052, AND(Branch046, AND(RawSorterBeltCCWManPB, AND(NOT(PrevRawCCW), NOT(ManRawCW)))))
  ManRawCCW := SEL(AND(NOT(ResetState), Branch052), ManRawCCW, NOT(ManRawCCW))
  RawSorterBeltCCW := SEL(AND(NOT(ResetState), Branch046), RawSorterBeltCCW, ManRawCCW)
  Branch053 := SEL(NOT(ResetState), Branch053, AND(Branch046, AND(RawSorterBeltCWManPB, AND(NOT(PrevRawCW), NOT(ManRawCCW)))))
  ManRawCW := SEL(AND(NOT(ResetState), Branch053), ManRawCW, NOT(ManRawCW))
  RawSorterBeltCW := SEL(AND(NOT(ResetState), Branch046), RawSorterBeltCW, ManRawCW)
  Branch054 := SEL(NOT(ResetState), Branch054, AND(Branch046, AND(RawSorterBeltTurnManPB, NOT(PrevRawTurn))))
  ManRawTurn := SEL(AND(NOT(ResetState), Branch054), ManRawTurn, NOT(ManRawTurn))
  RawSorterBeltTurn := SEL(AND(NOT(ResetState), Branch046), RawSorterBeltTurn, ManRawTurn)
  Branch055 := SEL(NOT(ResetState), Branch055, AND(Branch046, AND(BaseSorterBeltCCWManPB, AND(NOT(PrevBaseCCW), NOT(ManBaseCW)))))
  ManBaseCCW := SEL(AND(NOT(ResetState), Branch055), ManBaseCCW, NOT(ManBaseCCW))
  BaseSorterBeltCCW := SEL(AND(NOT(ResetState), Branch046), BaseSorterBeltCCW, ManBaseCCW)
  Branch056 := SEL(NOT(ResetState), Branch056, AND(Branch046, AND(BaseSorterBeltCWManPB, AND(NOT(PrevBaseCW), NOT(ManBaseCCW)))))
  ManBaseCW := SEL(AND(NOT(ResetState), Branch056), ManBaseCW, NOT(ManBaseCW))
  BaseSorterBeltCW := SEL(AND(NOT(ResetState), Branch046), BaseSorterBeltCW, ManBaseCW)
  Branch057 := SEL(NOT(ResetState), Branch057, AND(Branch046, AND(BaseSorterBeltTurnManPB, NOT(PrevBaseTurn))))
  ManBaseTurn := SEL(AND(NOT(ResetState), Branch057), ManBaseTurn, NOT(ManBaseTurn))
  BaseSorterBeltTurn := SEL(AND(NOT(ResetState), Branch046), BaseSorterBeltTurn, ManBaseTurn)
  Branch058 := SEL(NOT(ResetState), Branch058, AND(Branch046, AND(LidSorterBeltCCWManPB, AND(NOT(PrevLidCCW), NOT(ManLidCW)))))
  ManLidCCW := SEL(AND(NOT(ResetState), Branch058), ManLidCCW, NOT(ManLidCCW))
  LidSorterBeltCCW := SEL(AND(NOT(ResetState), Branch046), LidSorterBeltCCW, ManLidCCW)
  Branch059 := SEL(NOT(ResetState), Branch059, AND(Branch046, AND(LidSorterBeltCWManPB, AND(NOT(PrevLidCW), NOT(ManLidCCW)))))
  ManLidCW := SEL(AND(NOT(ResetState), Branch059), ManLidCW, NOT(ManLidCW))
  LidSorterBeltCW := SEL(AND(NOT(ResetState), Branch046), LidSorterBeltCW, ManLidCW)
  Branch060 := SEL(NOT(ResetState), Branch060, AND(Branch046, AND(LidSorterBeltTurnManPB, NOT(PrevLidTurn))))
  ManLidTurn := SEL(AND(NOT(ResetState), Branch060), ManLidTurn, NOT(ManLidTurn))
  LidSorterBeltTurn := SEL(AND(NOT(ResetState), Branch046), LidSorterBeltTurn, ManLidTurn)
  RejectPusher := SEL(AND(NOT(ResetState), Branch046), RejectPusher, ManReject)
  Branch061 := SEL(NOT(ResetState), Branch061, AND(Branch046, Reset))
  Branch062 := SEL(NOT(ResetState), Branch062, AND(Branch046, NOT(Branch061)))
  ResetHeld := SEL(AND(NOT(ResetState), Branch061), ResetHeld, ADD(ResetHeld, ScanDtS))
  ResetHeld := SEL(AND(NOT(ResetState), Branch062), ResetHeld, 0.0)
  Branch063 := SEL(NOT(ResetState), Branch063, AND(Branch046, GE(ResetHeld, 5.0)))
  RawCounter := SEL(AND(NOT(ResetState), Branch063), RawCounter, 0)
  BaseCounter := SEL(AND(NOT(ResetState), Branch063), BaseCounter, 0)
  LidCounter := SEL(AND(NOT(ResetState), Branch063), LidCounter, 0)
  ResetHeld := SEL(AND(NOT(ResetState), Branch047), ResetHeld, 0.0)
  NETWORK 'Output arbitration'
  // Output arbitration. The blinking ControlOnPL is never used as the motion
  // permissive: only the actual X3 state can permit motion.
  Branch064 := SEL(NOT(ResetState), Branch064, EQ(Mode, 0))
  BeltSpeedRef := SEL(AND(NOT(ResetState), Branch064), BeltSpeedRef, 0)
  RunningPL := SEL(AND(NOT(ResetState), Branch064), RunningPL, FALSE)
  BeltSpeedRef := SEL(NOT(ResetState), BeltSpeedRef, LIMIT( 0 , BeltSpeedRef , 300 ))
  TargetBeltSpeed := SEL(NOT(ResetState), TargetBeltSpeed, DIV(MUL(BeltSpeedRef, 10.0), 300.0))
  BeltConveyor4mSpeed := SEL(NOT(ResetState), BeltConveyor4mSpeed, TargetBeltSpeed)
  BeltConveyor4mSpeed2 := SEL(NOT(ResetState), BeltConveyor4mSpeed2, TargetBeltSpeed)
  BeltConveyor4mPL := SEL(NOT(ResetState), BeltConveyor4mPL, GT(BeltSpeedRef, 0))
  StartPL := SEL(NOT(ResetState), StartPL, AND(EQ(Mode, 5), OR(RunningPL, Blink)))
  RawSorterBeltCCWPL := SEL(NOT(ResetState), RawSorterBeltCCWPL, RawSorterBeltCCW)
  RawSorterBeltCWPL := SEL(NOT(ResetState), RawSorterBeltCWPL, RawSorterBeltCW)
  RawSorterBeltTurnPL := SEL(NOT(ResetState), RawSorterBeltTurnPL, RawSorterBeltTurn)
  BaseSorterBeltCCWPL := SEL(NOT(ResetState), BaseSorterBeltCCWPL, BaseSorterBeltCCW)
  BaseSorterBeltCWPL := SEL(NOT(ResetState), BaseSorterBeltCWPL, BaseSorterBeltCW)
  BaseSorterBeltTurnPL := SEL(NOT(ResetState), BaseSorterBeltTurnPL, BaseSorterBeltTurn)
  LidSorterBeltCCWPL := SEL(NOT(ResetState), LidSorterBeltCCWPL, LidSorterBeltCCW)
  LidSorterBeltCWPL := SEL(NOT(ResetState), LidSorterBeltCWPL, LidSorterBeltCW)
  LidSorterBeltTurnPL := SEL(NOT(ResetState), LidSorterBeltTurnPL, LidSorterBeltTurn)
  RejectPusherPL := SEL(NOT(ResetState), RejectPusherPL, RejectPusher)
  NETWORK 'Scene support outputs absent from the charts actions'
  // Scene support outputs absent from the chart's actions.
  Remover1 := SEL(NOT(ResetState), Remover1, TRUE)
  Remover2 := SEL(NOT(ResetState), Remover2, TRUE)
  Remover3 := SEL(NOT(ResetState), Remover3, TRUE)
  LabPLCRunning := SEL(NOT(ResetState), LabPLCRunning, Blink)
  SkidPLCRunning := SEL(NOT(ResetState), SkidPLCRunning, Blink)
  LocalPanelActive := SEL(NOT(ResetState), LocalPanelActive, LocalControlPanel)
  RemotePanelActive := SEL(NOT(ResetState), RemotePanelActive, RemoteControlPanel)
  IncSpdX1Light := SEL(NOT(ResetState), IncSpdX1Light, IncSpdX100)
  IncSpdX10Light := SEL(NOT(ResetState), IncSpdX10Light, IncSpdX10)
  DecSpdX10Light := SEL(NOT(ResetState), DecSpdX10Light, DecSpdX10)
  DecSpdX100Light := SEL(NOT(ResetState), DecSpdX100Light, DecSpdX100)
  StopBlade := SEL(NOT(ResetState), StopBlade, FALSE)
  Spare := SEL(NOT(ResetState), Spare, FALSE)
  ProductionRate := SEL(NOT(ResetState), ProductionRate, 0)
  PrevMode := SEL(NOT(ResetState), PrevMode, Mode)
  PrevClassify := SEL(NOT(ResetState), PrevClassify, ClassifyDefuseSensor)
  PrevStart := SEL(NOT(ResetState), PrevStart, Start)
  PrevReset := SEL(NOT(ResetState), PrevReset, Reset)
  PrevInc10 := SEL(NOT(ResetState), PrevInc10, IncSpdX10)
  PrevInc100 := SEL(NOT(ResetState), PrevInc100, IncSpdX100)
  PrevDec10 := SEL(NOT(ResetState), PrevDec10, DecSpdX10)
  PrevDec100 := SEL(NOT(ResetState), PrevDec100, DecSpdX100)
  PrevBelt := SEL(NOT(ResetState), PrevBelt, BeltConveyor4mManPB)
  PrevReject := SEL(NOT(ResetState), PrevReject, RejectPusherManPB)
  PrevRawCCW := SEL(NOT(ResetState), PrevRawCCW, RawSorterBeltCCWManPB)
  PrevRawCW := SEL(NOT(ResetState), PrevRawCW, RawSorterBeltCWManPB)
  PrevRawTurn := SEL(NOT(ResetState), PrevRawTurn, RawSorterBeltTurnManPB)
  PrevBaseCCW := SEL(NOT(ResetState), PrevBaseCCW, BaseSorterBeltCCWManPB)
  PrevBaseCW := SEL(NOT(ResetState), PrevBaseCW, BaseSorterBeltCWManPB)
  PrevBaseTurn := SEL(NOT(ResetState), PrevBaseTurn, BaseSorterBeltTurnManPB)
  PrevLidCCW := SEL(NOT(ResetState), PrevLidCCW, LidSorterBeltCCWManPB)
  PrevLidCW := SEL(NOT(ResetState), PrevLidCW, LidSorterBeltCWManPB)
  PrevLidTurn := SEL(NOT(ResetState), PrevLidTurn, LidSorterBeltTurnManPB)
END_FBD
END_FUNCTION_BLOCK
