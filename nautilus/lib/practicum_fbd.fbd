(* FBD build of the Final Practicum controller for the Open Industry
   Project (OIP) scene. Originally generated from the Factory I/O
   control.st by tools/build_languages.py, then restructured by hand: one
   network per function, one block per line, named wires, and only the
   devices the OIP scene has.

   Gone with Factory I/O: the sorter belts' CW/CCW commands, buttons and
   lamps, the removers, the spare output and the 0..10 V belt speeds. The
   sort lanes are pushers now. This block chooses the lane (RawFlag,
   BaseFlag, LidFlag) and gives the belt speed in cm/s (BeltSpeedRef); Main
   times each push from the lane's sort eye, converts the speed to m/s and
   packs the stack light from RunningPL, WarningLight1 and EStoppedPL.

   A wire is its expression, worked out again wherever it is used. So a
   wire that reads a variable is only used before that variable's coil;
   after the coil the logic reads the variable itself.

   While ResetState is TRUE the block clears its private state, leaves the
   shared numbers (steps, speeds, totals) alone and drops every command;
   Main then decides what the outputs are for that scan. *)
FUNCTION_BLOCK PracticumFBD
VAR_EXTERNAL
    AtExit : BOOL;
    AutoSS : BOOL;
    RejectDiffuseSensor : BOOL;
    DecSpdX10 : BOOL;
    DecSpdX100 : BOOL;
    EmergencyStop : BOOL;
    EmergencyStop2 : BOOL;
    FIOReset : BOOL;
    IncSpdX100 : BOOL;
    IncSpdX10 : BOOL;
    LocalControlPanel : BOOL;
    ManualSS : BOOL;
    RejPushBackLimit : BOOL;
    RejPushFrontLimit : BOOL;
    RemoteControlPanel : BOOL;
    Reset : BOOL;
    Start : BOOL;
    Stop : BOOL;
    ClassifyDefuseSensor : BOOL;
    BaseSorterBeltTurnManPB : BOOL;
    LidSorterBeltTurnManPB : BOOL;
    RawSorterBeltTurnManPB : BOOL;
    BeltConveyor4mManPB : BOOL;
    RejectPusherManPB : BOOL;
    SendSortPB : BOOL;
    SendRejectPB : BOOL;
    Reset2PB : BOOL;
    VisionSensor1 : INT;
    BaseLightInd : BOOL;
    BaseSorterBeltTurn : BOOL;
    DecSpdX10Light : BOOL;
    DecSpdX100Light : BOOL;
    Emitter : BOOL;
    IncSpdX1Light : BOOL;
    IncSpdX10Light : BOOL;
    LabPLCRunning : BOOL;
    LidLightInd : BOOL;
    LidSorterBeltTurn : BOOL;
    LocalPanelActive : BOOL;
    RawLightInd : BOOL;
    RawSorterBeltTurn : BOOL;
    RejectPusher : BOOL;
    RemotePanelActive : BOOL;
    ControlOnPL : BOOL;
    SkidPLCRunning : BOOL;
    StartPL : BOOL;
    StopBlade : BOOL;
    StopPL : BOOL;
    WarningLight1 : BOOL;
    AutoPL : BOOL;
    RawSorterBeltTurnPL : BOOL;
    BaseSorterBeltTurnPL : BOOL;
    LidSorterBeltTurnPL : BOOL;
    ManualPL : BOOL;
    BeltConveyor4mPL : BOOL;
    RejectPusherPL : BOOL;
    ControlOnPL2 : BOOL;
    EStoppedPL : BOOL;
    RunningPL : BOOL;
    BaseCounter : INT;
    BeltSpeedRef : INT;
    LidCounter : INT;
    ProductionRate : INT;
    RawCounter : INT;
    RejectFlag : BOOL;
    EmitFlag : BOOL;
    RawFlag : BOOL;
    BaseFlag : BOOL;
    LidFlag : BOOL;
    LastBeltRefSpeed : INT;
    ScanDtS : REAL;
    MainStep : INT;
    AutoStep : INT;
    Mode : INT;
END_VAR
VAR_INPUT
    ResetState : BOOL;
END_VAR
VAR
    ClockS : REAL;
    AutoElapsed : REAL;
    EmitRemaining : REAL;
    SortElapsed : REAL;
    ResetHeld : REAL;
    PrevMode : INT;
    ScanStep : INT;
    ManBelt : BOOL;
    ManReject : BOOL;
    ManRawPush : BOOL;
    ManBasePush : BOOL;
    ManLidPush : BOOL;
END_VAR
VAR CONSTANT
    BLINK_PERIOD_S : REAL := 1.0;     (* lamp blink period *)
    BLINK_ON_S : REAL := 0.5;         (* lit for the first half of the period *)
    WARN_TIME_S : REAL := 3.0;        (* start warning before the belt moves *)
    EMIT_PULSE_S : REAL := 0.5;       (* emitter pulse that releases one box *)
    SORT_DWELL_S : REAL := 0.5;       (* wait after a sorted box reaches the exit *)
    RESET_HOLD_S : REAL := 5.0;       (* Reset hold that clears the totals *)
    VISION_REJECT_MIN : INT := 7;     (* colour codes 7..9 (metal) are rejects *)
    VISION_REJECT_MAX : INT := 9;
END_VAR

FBD
  NETWORK 'Blink clock: 1 s period, lit for the first half'
  run = NOT(ResetState)
  clockNext = ADD(ClockS, ScanDtS)
  clockOver = GE(clockNext, BLINK_PERIOD_S)
  clockWrapped = SEL(clockOver, clockNext, SUB(clockNext, BLINK_PERIOD_S))
  clockNow = SEL(ResetState, clockWrapped, 0.0)
  ClockS := clockNow
  blink = AND(run, LT(ClockS, BLINK_ON_S))

  NETWORK 'Main step: 1 E-stopped, 2 waiting for reset, 3 control on'
  // Stop and both emergency stops are NC: TRUE = healthy. A simulation
  // reset (FIOReset) trips the chart like an E-stop.
  tripped = OR(NOT(EmergencyStop), NOT(EmergencyStop2), FIOReset)
  resetCall = OR(Reset, Reset2PB)
  lineClear = AND(NOT(ClassifyDefuseSensor), NOT(RejectDiffuseSensor), AtExit)
  eStopped = EQ(MainStep, 1)
  // E-stops healthy again, or Stop pressed with control on: wait for a reset
  toWaiting = EQ(eStopped, Stop)
  toControlOn = AND(EQ(MainStep, 2), Stop, resetCall, lineClear)
  stepWaiting = SEL(toWaiting, MainStep, 2)
  stepControl = SEL(toControlOn, stepWaiting, 3)
  // a trip beats every other transition
  stepNext = SEL(tripped, stepControl, 1)
  stepNow = SEL(ResetState, stepNext, MainStep)
  MainStep := stepNow

  NETWORK 'Control lamps'
  // ready is the only motion permissive: the real step, never a lamp
  ready = AND(run, EQ(MainStep, 3))
  controlLamp = OR(ready, blink)
  ControlOnPL := controlLamp
  ControlOnPL2 := controlLamp
  StopPL := NOT(ready)
  EStoppedPL := AND(EQ(MainStep, 1), blink)

  NETWORK 'Mode: 0 none, 4 manual, 5 automatic'
  // conflicting selectors give no mode at all
  inManual = AND(ready, ManualSS, NOT(AutoSS))
  inAuto = AND(ready, AutoSS, NOT(ManualSS))
  modeManual = SEL(inManual, 0, 4)
  modeNow = SEL(inAuto, modeManual, 5)
  noMode = EQ(modeNow, 0)
  // leaving a mode deactivates its child chart
  modeChanged = AND(run, NE(modeNow, PrevMode))
  Mode := SEL(ResetState, modeNow, Mode)
  ManualPL := inManual
  AutoPL := inAuto

  NETWORK 'Mode change: a new mode starts stopped, at the first auto step'
  BeltSpeedRef := SEL(modeChanged, BeltSpeedRef, 0)
  LastBeltRefSpeed := SEL(modeChanged, LastBeltRefSpeed, 0)
  AutoStep := SEL(modeChanged, AutoStep, 16)
  timersClear = OR(ResetState, modeChanged)
  AutoElapsed := SEL(timersClear, AutoElapsed, 0.0)
  EmitRemaining := SEL(timersClear, EmitRemaining, 0.0)
  SortElapsed := SEL(timersClear, SortElapsed, 0.0)

  NETWORK 'Belt speed reference: 10 and 100 cm/s steps, 0..300'
  up10 : R_TRIG(CLK := IncSpdX10)
  up100 : R_TRIG(CLK := IncSpdX100)
  down10 : R_TRIG(CLK := DecSpdX10)
  down100 : R_TRIG(CLK := DecSpdX100)
  raise = ADD(SEL(up10.Q, 0, 10), SEL(up100.Q, 0, 100))
  lower = ADD(SEL(down10.Q, 0, 10), SEL(down100.Q, 0, 100))
  speedAsked = SUB(ADD(BeltSpeedRef, raise), lower)
  speedSet = LIMIT(0, speedAsked, 300)
  // the operator's last setting is what automatic returns to
  speedEdited = OR(up10.Q, up100.Q, down10.Q, down100.Q)
  speedKeep = AND(ready, speedEdited)
  LastBeltRefSpeed := SEL(speedKeep, LastBeltRefSpeed, speedSet)
  BeltSpeedRef := SEL(ready, BeltSpeedRef, speedSet)

  NETWORK 'Automatic: wait for Start, then a three second warning'
  // X16/X21 wait for Start, X20 warning, X19 emit a box, X22 classify,
  // X24/X27/X28 sort (+100 box left the exit eye, +200 box back at it),
  // X25/X85/X86 reject. Every transition tests ScanStep, the step the
  // scan started in, so the chart moves one step per scan.
  ScanStep := SEL(inAuto, 0, AutoStep)
  AutoStep := SEL(EQ(ScanStep, 16), AutoStep, 21)
  startCall = AND(EQ(ScanStep, 21), Start)
  AutoStep := SEL(startCall, AutoStep, 20)
  AutoElapsed := SEL(startCall, AutoElapsed, 0.0)
  warnStep = EQ(ScanStep, 20)
  warnTime = ADD(AutoElapsed, ScanDtS)
  AutoElapsed := SEL(warnStep, AutoElapsed, warnTime)
  warnDone = AND(warnStep, GE(AutoElapsed, WARN_TIME_S))
  // flashes opposite the panel lamps during the warning
  WarningLight1 := AND(warnStep, NOT(blink))
  // seals in from the end of the warning until the mode is lost
  runningSet = OR(warnDone, RunningPL)
  RunningPL := AND(runningSet, NOT(modeChanged), NOT(noMode))

  NETWORK 'Automatic: classify the box at the colour sensor'
  emitStep = EQ(ScanStep, 19)
  EmitFlag := emitStep
  boxEye : R_TRIG(CLK := ClassifyDefuseSensor)
  // slow to 60 cm/s past the colour sensor, remembering the running speed
  boxSeen = AND(emitStep, boxEye.Q)
  LastBeltRefSpeed := SEL(boxSeen, LastBeltRefSpeed, BeltSpeedRef)
  BeltSpeedRef := SEL(boxSeen, BeltSpeedRef, 60)
  AutoStep := SEL(boxSeen, AutoStep, 22)
  classifyStep = EQ(ScanStep, 22)
  rejectCode = AND(GE(VisionSensor1, VISION_REJECT_MIN), LE(VisionSensor1, VISION_REJECT_MAX))
  // SORT/REJECT selector on REJECT, or a metal box; reject has priority
  rejectCall = OR(SendRejectPB, rejectCode)
  toReject = AND(classifyStep, rejectCall)
  AutoStep := SEL(toReject, AutoStep, 25)
  sortCall = AND(classifyStep, NOT(rejectCall), SendSortPB)

  NETWORK 'Automatic: count the sorted box and pick its lane'
  // colour codes: 1, 4 raw material; 3, 6 base; 2, 5 lid
  rawCode = OR(EQ(VisionSensor1, 1), EQ(VisionSensor1, 4))
  baseCode = OR(EQ(VisionSensor1, 3), EQ(VisionSensor1, 6))
  lidCode = OR(EQ(VisionSensor1, 2), EQ(VisionSensor1, 5))
  toRaw = AND(sortCall, rawCode)
  toBase = AND(sortCall, baseCode)
  toLid = AND(sortCall, lidCode)
  AutoStep := SEL(toRaw, AutoStep, 24)
  AutoStep := SEL(toBase, AutoStep, 27)
  AutoStep := SEL(toLid, AutoStep, 28)
  RawCounter := SEL(toRaw, RawCounter, ADD(RawCounter, 1))
  BaseCounter := SEL(toBase, BaseCounter, ADD(BaseCounter, 1))
  LidCounter := SEL(toLid, LidCounter, ADD(LidCounter, 1))
  // the box leaves the sensor at the speed it arrived with
  sorted = OR(toRaw, toBase, toLid)
  BeltSpeedRef := SEL(sorted, BeltSpeedRef, LastBeltRefSpeed)

  NETWORK 'Automatic: follow the sorted box past the exit eye'
  sortStep = OR(EQ(ScanStep, 24), EQ(ScanStep, 27), EQ(ScanStep, 28))
  leavingStep = OR(EQ(ScanStep, 124), EQ(ScanStep, 127), EQ(ScanStep, 128))
  dwellStep = OR(EQ(ScanStep, 224), EQ(ScanStep, 227), EQ(ScanStep, 228))
  // previous box off the exit eye, then the eye made again
  exitClear = AND(sortStep, NOT(AtExit))
  exitMade = AND(leavingStep, AtExit)
  exitMoved = OR(exitClear, exitMade)
  AutoStep := SEL(exitMoved, AutoStep, ADD(AutoStep, 100))
  SortElapsed := SEL(exitMade, SortElapsed, 0.0)
  // short settle time before the next box is released
  dwellTime = ADD(SortElapsed, ScanDtS)
  SortElapsed := SEL(dwellStep, SortElapsed, dwellTime)
  sortDone = AND(dwellStep, GE(SortElapsed, SORT_DWELL_S))

  NETWORK 'Automatic: reject with the pusher'
  // stop the belt with the box in front of the pusher
  atPusher = AND(EQ(ScanStep, 25), RejectDiffuseSensor)
  AutoStep := SEL(atPusher, AutoStep, 85)
  BeltSpeedRef := SEL(atPusher, BeltSpeedRef, 0)
  pushedOut = AND(EQ(ScanStep, 85), RejPushFrontLimit)
  AutoStep := SEL(pushedOut, AutoStep, 86)
  rejectDone = AND(EQ(ScanStep, 86), RejPushBackLimit)

  NETWORK 'Automatic: resume speed and emit the next box'
  // every path ends the same way
  nextBox = OR(warnDone, sortDone, rejectDone)
  AutoStep := SEL(nextBox, AutoStep, 19)
  BeltSpeedRef := SEL(nextBox, BeltSpeedRef, LastBeltRefSpeed)
  pulseLeft = SEL(nextBox, EmitRemaining, EMIT_PULSE_S)
  emitting = AND(inAuto, GT(pulseLeft, 0.0))
  Emitter := emitting
  EmitRemaining := SEL(emitting, pulseLeft, SUB(pulseLeft, ScanDtS))

  NETWORK 'Lane flags: arm that lane pusher in Main until the box has gone'
  rawLane = OR(EQ(AutoStep, 24), EQ(AutoStep, 124), EQ(AutoStep, 224))
  baseLane = OR(EQ(AutoStep, 27), EQ(AutoStep, 127), EQ(AutoStep, 227))
  lidLane = OR(EQ(AutoStep, 28), EQ(AutoStep, 128), EQ(AutoStep, 228))
  rejectLane = OR(EQ(AutoStep, 25), EQ(AutoStep, 85))
  RawFlag := AND(inAuto, rawLane)
  BaseFlag := AND(inAuto, baseLane)
  LidFlag := AND(inAuto, lidLane)
  RejectFlag := AND(inAuto, rejectLane)

  NETWORK 'Manual belt: press to run at 60 cm/s, press again to stop'
  beltPb : R_TRIG(CLK := BeltConveyor4mManPB)
  ManBelt := AND(inManual, XOR(beltPb.Q, ManBelt))
  beltToggled = AND(inManual, beltPb.Q)
  manSpeed = SEL(ManBelt, 0, 60)
  BeltSpeedRef := SEL(beltToggled, BeltSpeedRef, manSpeed)

  NETWORK 'Raw lane pusher: PUSH button in manual, panel light in automatic'
  // each press of the lane's PUSH button toggles the pusher; drops with manual mode
  rawPushPb : R_TRIG(CLK := RawSorterBeltTurnManPB)
  ManRawPush := AND(inManual, XOR(rawPushPb.Q, ManRawPush))
  // panel RAW light: a box has just been sent to this lane
  rawSorting = AND(inAuto, EQ(AutoStep, 24))
  rawCall = OR(rawSorting, ManRawPush)
  RawLightInd := rawSorting
  // Main jogs the pusher from this in manual; the tag keeps its Factory I/O name
  RawSorterBeltTurn := rawCall
  RawSorterBeltTurnPL := rawCall

  NETWORK 'Base lane pusher: PUSH button in manual, panel light in automatic'
  // each press of the lane's PUSH button toggles the pusher; drops with manual mode
  basePushPb : R_TRIG(CLK := BaseSorterBeltTurnManPB)
  ManBasePush := AND(inManual, XOR(basePushPb.Q, ManBasePush))
  // panel BASE light: a box has just been sent to this lane
  baseSorting = AND(inAuto, EQ(AutoStep, 27))
  baseCall = OR(baseSorting, ManBasePush)
  BaseLightInd := baseSorting
  // Main jogs the pusher from this in manual; the tag keeps its Factory I/O name
  BaseSorterBeltTurn := baseCall
  BaseSorterBeltTurnPL := baseCall

  NETWORK 'Lid lane pusher: PUSH button in manual, panel light in automatic'
  // each press of the lane's PUSH button toggles the pusher; drops with manual mode
  lidPushPb : R_TRIG(CLK := LidSorterBeltTurnManPB)
  ManLidPush := AND(inManual, XOR(lidPushPb.Q, ManLidPush))
  // panel LID light: a box has just been sent to this lane
  lidSorting = AND(inAuto, EQ(AutoStep, 28))
  lidCall = OR(lidSorting, ManLidPush)
  LidLightInd := lidSorting
  // Main jogs the pusher from this in manual; the tag keeps its Factory I/O name
  LidSorterBeltTurn := lidCall
  LidSorterBeltTurnPL := lidCall

  NETWORK 'Reject pusher: sequence in automatic, toggle in manual'
  rejectPb : R_TRIG(CLK := RejectPusherManPB)
  ManReject := AND(inManual, XOR(rejectPb.Q, ManReject))
  // out while the reject step waits for the front limit
  pushStep = AND(inAuto, EQ(AutoStep, 85))
  pusherOut = OR(pushStep, ManReject)
  RejectPusher := pusherOut
  RejectPusherPL := pusherOut

  NETWORK 'Totals: five continuous seconds of Reset in manual clears them'
  holding = AND(inManual, Reset)
  heldTime = SEL(holding, 0.0, ADD(ResetHeld, ScanDtS))
  ResetHeld := heldTime
  totalsClear = AND(inManual, GE(ResetHeld, RESET_HOLD_S))
  RawCounter := SEL(totalsClear, RawCounter, 0)
  BaseCounter := SEL(totalsClear, BaseCounter, 0)
  LidCounter := SEL(totalsClear, LidCounter, 0)

  NETWORK 'Belt speed out: 0..300 cm/s, Main converts it to m/s'
  // without a mode the belts have no reference
  speedMode = SEL(noMode, BeltSpeedRef, 0)
  speedOut = LIMIT(0, speedMode, 300)
  BeltSpeedRef := SEL(ResetState, speedOut, BeltSpeedRef)
  BeltConveyor4mPL := AND(run, GT(BeltSpeedRef, 0))
  // blinks to invite Start, steady once the line runs
  StartPL := AND(inAuto, OR(RunningPL, blink))

  NETWORK 'Panel lamps and housekeeping'
  LabPLCRunning := blink
  SkidPLCRunning := blink
  LocalPanelActive := AND(run, LocalControlPanel)
  RemotePanelActive := AND(run, RemoteControlPanel)
  // button feedback; the +100 button's lamp tag is IncSpdX1Light
  IncSpdX1Light := AND(run, IncSpdX100)
  IncSpdX10Light := AND(run, IncSpdX10)
  DecSpdX10Light := AND(run, DecSpdX10)
  DecSpdX100Light := AND(run, DecSpdX100)
  // the blade between the belts is never used: hold it down
  StopBlade := FALSE
  // the RATE display shows 0
  ProductionRate := SEL(ResetState, 0, ProductionRate)

  NETWORK 'Scan end: remember the mode to spot the next change'
  PrevMode := SEL(ResetState, modeNow, 0)
END_FBD
END_FUNCTION_BLOCK
