                AutoStep := 27; BaseCounter := BaseCounter + 1;
                BeltSpeedRef := LastBeltRefSpeed;
            ELSIF (VisionSensor1 = 2) OR (VisionSensor1 = 5) THEN
                AutoStep := 28; LidCounter := LidCounter + 1;
                BeltSpeedRef := LastBeltRefSpeed;
            END_IF;
        END_IF;
