       OR (DecSpdX10 AND NOT PrevDec10) OR (DecSpdX100 AND NOT PrevDec100) THEN
        LastBeltRefSpeed := BeltSpeedRef;
    END_IF;
END_IF;

(* Automatic: X16/X21 wait, X20 three second warning, X19 emit,
   X22 classify, X24/X27/X28 sorting, X25 rejection. *)
