    16: AutoStep := 21;
    21:
        IF Start THEN AutoStep := 20; AutoElapsed := 0.0; END_IF;
    20:
        WarningLight1 := NOT Blink;
        AutoElapsed := AutoElapsed + ScanDtS;
        IF AutoElapsed >= 3.0 THEN
            AutoStep := 19;
            EmitRemaining := 0.5;
            BeltSpeedRef := LastBeltRefSpeed;
            RunningPL := TRUE;
        END_IF;
