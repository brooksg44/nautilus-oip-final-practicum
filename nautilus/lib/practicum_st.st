IF ClockS >= 1.0 THEN ClockS := ClockS - 1.0; END_IF;
Blink := ClockS < 0.5;
IF NOT EmergencyStop OR NOT EmergencyStop2 OR FIOReset THEN
    MainStep := 1;
ELSIF MainStep = 1 THEN
    IF Stop THEN MainStep := 2; END_IF;
ELSIF NOT Stop THEN
    MainStep := 2;
ELSIF MainStep = 2 THEN
