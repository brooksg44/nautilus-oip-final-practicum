    IF IncSpdX10 AND NOT PrevInc10 THEN BeltSpeedRef := BeltSpeedRef + 10; END_IF;
    IF IncSpdX100 AND NOT PrevInc100 THEN BeltSpeedRef := BeltSpeedRef + 100; END_IF;
    IF DecSpdX10 AND NOT PrevDec10 THEN BeltSpeedRef := BeltSpeedRef - 10; END_IF;
    IF DecSpdX100 AND NOT PrevDec100 THEN BeltSpeedRef := BeltSpeedRef - 100; END_IF;
    BeltSpeedRef := LIMIT(0, BeltSpeedRef, 300);
