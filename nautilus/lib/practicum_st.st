RawFlag := FALSE; BaseFlag := FALSE; LidFlag := FALSE; RejectFlag := FALSE;

(* Continuous: +/-10 and +/-100 cm/s on rising edges, clamp 0..300.
   Use real division for Modbus voltage scaling; the source has three
   mutually incompatible platform scaling examples. *)
